# 版本控制与仓库元数据
.git
.gitignore
.gitattributes

# 编辑器 / IDE
.idea
.vscode
.opencode
.history

# 不需要进入 Web 构建上下文
.github
docs
compose.yaml
apps/api
scripts

# 依赖与构建产物
**/node_modules
**/dist
**/coverage
**/*.tsbuildinfo
**/.vite

# 本地环境与日志
.env
.env.*
!.env.example
**/*.log
**/.DS_Store

# 注意：contracts/ 必须保留（设计令牌在构建时被读取）
# 注意：apps/web/packages/ 与 apps/ 必须保留（workspace 依赖）
