# 版本控制与仓库元数据
.git
.gitignore
.gitattributes

# 编辑器 / IDE
.idea
.vscode
.opencode
.history

# CI 与文档（构建镜像不需要）
.github
docs
infra

# 依赖与构建产物
**/node_modules
**/dist
**/coverage
**/*.tsbuildinfo
**/.vite

# 本地环境与日志
.env
.env.*
!.env.example
**/*.log
**/.DS_Store

# 注意：contracts/ 必须保留（设计令牌在构建时被读取）
# 注意：packages/ 与 apps/ 必须保留（workspace 依赖）
