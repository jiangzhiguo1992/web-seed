{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/platform/config/env.json",
  "$comment": "env vars 唯一真相源。生成 .env.example 与 Go/TS 校验；新增变量必须登记，否则测试失败。",
  "title": "Environment variables",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "APP_ENV",
    "HTTP_ADDR"
  ],
  "properties": {
    "APP_ENV": {
      "type": "string",
      "enum": [
        "dev",
        "test",
        "staging",
        "prod"
      ],
      "default": "dev",
      "description": "运行环境，必须与 platform.environments 一致"
    },
    "HTTP_ADDR": {
      "type": "string",
      "pattern": "^:[0-9]{2,5}$|^[0-9.]+:[0-9]{2,5}$",
      "default": ":8080",
      "description": "HTTP 监听地址"
    },
    "LOG_LEVEL": {
      "type": "string",
      "enum": [
        "debug",
        "info",
        "warn",
        "error"
      ],
      "default": "info"
    },
    "DATABASE_URL": {
      "type": "string",
      "format": "uri",
      "secret": true,
      "description": "PostgreSQL 连接串；生产由平台注入"
    },
    "DATABASE_MAX_CONNS": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200,
      "default": 20
    },
    "JWT_SECRET": {
      "type": "string",
      "minLength": 32,
      "secret": true,
      "description": "HS256 密钥；生产由密钥管理注入"
    },
    "HTTP_CORS_ORIGINS": {
      "type": "string",
      "description": "逗号分隔的允许来源；默认取 platform.environments"
    },
    "OTEL_EXPORTER": {
      "type": "string",
      "enum": [
        "none",
        "otlp"
      ],
      "default": "none",
      "description": "默认不外发追踪"
    }
  },
  "x-contract-id": "platform.config.env",
  "x-contract-summary": "环境变量 schema"
}
